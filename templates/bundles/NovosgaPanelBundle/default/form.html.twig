{% extends "@NovosgaPanel/base.html.twig" %}

{% trans_default_domain 'NovosgaPanelBundle' %}

{% block body %}
    <div class="d-flex">
        <div>
            <h1>
                <i class="fa fa-tv" aria-hidden="true"></i> {{ 'title'|trans }}
            </h1>
            <p>{{ 'subtitle'|trans }}</p>
        </div>
        <div class="ms-auto mt-3">
            {% if entity.id %}
                <a href="{{ path('painel_show', { publicId: entity.publicId }) }}" class="btn btn-outline-success ms-2" target="_blank">
                    <i class="fa fa-tv"></i>
                    {{ 'button.open_painel'|trans }}
                </a>
            {% endif %}
        </div>
    </div>

    {{ form_start(form) }}

        {% include 'flashMessages.html.twig' %}

        <div class="row">
            <div class="col col-12 col-md-6 col-lg-4">
                {{ form_row(form.nome) }}

                <fieldset class="mt-4">
                    <legend class="fs-6 fw-semibold text-muted text-uppercase mb-3">{{ 'section.aparencia'|trans }}</legend>

                    {{ form_row(form.logo) }}

                    <div class="row row-cols-2">
                        <div class="col">
                            {{ form_row(form.corFundoDestaque) }}
                        </div>
                        <div class="col">
                            {{ form_row(form.corFundoHistorico) }}
                        </div>
                        <div class="col">
                            {{ form_row(form.corFundoRodape) }}
                        </div>
                        <div class="col">
                            {{ form_row(form.corFundoRelogio) }}
                        </div>
                    </div>
                </fieldset>

                {# ---- Chamada por voz (adicionado pelo fork HU) ---- #}
                <fieldset class="mt-4">
                    <legend class="fs-6 fw-semibold text-muted text-uppercase mb-3">
                        <i class="fa fa-volume-up"></i> Voz
                    </legend>

                    <div class="form-check mb-2">
                        {{ form_widget(form.vozAtiva) }}
                        {{ form_label(form.vozAtiva) }}
                    </div>
                    <div class="form-check mb-3">
                        {{ form_widget(form.falarNome) }}
                        {{ form_label(form.falarNome) }}
                    </div>

                    {{ form_row(form.vozModelo) }}

                    {{ form_row(form.vozVelocidade) }}
                    {# datalist: permite digitar um valor OU escolher um preset #}
                    <datalist id="voz-velocidade-presets">
                        <option value="1.0">1.0 — normal</option>
                        <option value="1.2">1.2 — um pouco mais devagar</option>
                        <option value="1.4">1.4 — mais devagar</option>
                        <option value="1.6">1.6 — recomendado (nomes)</option>
                        <option value="1.8">1.8 — bem devagar</option>
                        <option value="2.0">2.0 — máximo</option>
                    </datalist>

                    <div class="mt-3">
                        <button type="button" id="btn-testar-voz" class="btn btn-outline-primary btn-sm">
                            <i class="fa fa-play"></i> Testar voz
                        </button>
                        <span id="voz-teste-status" class="ms-2 small text-muted"></span>
                        <audio id="voz-teste-audio" class="d-none"></audio>
                    </div>
                </fieldset>
            </div>
            <div class="col col-12 col-md-6 col-lg-4">
                {{ form_row(form.servicos) }}
            </div>
            <div class="col offset-lg-1 col-12 col-lg-3">
                <div class="card border-secondary mb-4">
                    <div class="card-body">
                        <h5 class="card-title d-flex align-items-center gap-2">
                            <i class="fa fa-tv text-primary"></i>
                            <strong>Mangati Painel</strong>
                        </h5>

                        <p class="text-muted small mb-3">
                            Precisa de mais liberdade para customizar seu painel? Conheça o <strong>Mangati Painel</strong>,
                            uma plataforma completa com templates, widgets e muito mais.
                        </p>
                        <ul class="list-unstyled small mb-4">
                            <li class="mb-1"><i class="bi bi-layout-text-window-reverse text-primary me-1"></i> Templates customizados</li>
                            <li class="mb-1"><i class="bi bi-puzzle text-primary me-1"></i> Integração com NovoSGA (v1.x, v2.x)</li>
                            <li class="mb-1"><i class="bi bi-cloud-sun text-primary me-1"></i> Clima e tempo</li>
                            <li class="mb-1"><i class="bi bi-newspaper text-primary me-1"></i> Notícias (RSS/Atom)</li>
                            <li class="mb-1"><i class="bi bi-youtube text-primary me-1"></i> YouTube e Playlist</li>
                            <li class="mb-1"><i class="bi bi-code-slash text-primary me-1"></i> HTML / iFrame</li>
                            <li class="mb-1"><i class="bi bi-megaphone text-primary me-1"></i> Comunicados</li>
                            <li class="mb-1"><i class="bi bi-tv text-primary me-1"></i> IPTV</li>
                        </ul>
                        <a href="https://painel.mangati.com/" target="_blank" rel="noopener" class="btn btn-secondary btn-sm w-100">
                            Acessar a plataforma <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="fa fa-check"></i>
                {{ 'button.save'|trans }}
            </button>

            <a href="{{ path('novosga_panel_index') }}" class="btn btn-link text-decoration-none ms-2">
                <i class="fa fa-chevron-left"></i>
                {{ 'button.back'|trans }}
            </a>

            {% if entity.id %}
                <div class="ms-auto">
                    <button type="submit" form="form-delete" class="btn btn-danger">
                        <i class="fa fa-trash"></i>
                        {{ 'button.delete'|trans }}
                    </button>
                </div>
            {% endif %}
        </div>

    {{ form_end(form) }}

    {% if entity.id %}
        <form id="form-delete" method="post" action="{{ path('novosga_panel_delete', { id: entity.id }) }}" onsubmit="return confirm('{{ 'confirm.delete'|trans }}')">
            <input type="hidden" name="_token" value="{{ csrf_token('delete-painel-' ~ entity.id) }}">
        </form>
    {% endif %}

    {# Botão "testar voz": usa os valores atuais do formulário, sem precisar salvar #}
    <script>
        (function () {
            const btn = document.getElementById('btn-testar-voz');
            if (!btn) { return; }
            const modeloEl = document.getElementById('{{ form.vozModelo.vars.id }}');
            const velEl = document.getElementById('{{ form.vozVelocidade.vars.id }}');
            const audio = document.getElementById('voz-teste-audio');
            const status = document.getElementById('voz-teste-status');
            const baseUrl = '{{ path('painel_voz_teste') }}';

            btn.addEventListener('click', function () {
                const modelo = modeloEl ? modeloEl.value : 'piper';
                const vel = velEl ? velEl.value : '1.6';
                const url = baseUrl + '?model=' + encodeURIComponent(modelo)
                    + '&velocidade=' + encodeURIComponent(vel)
                    + '&t=' + Date.now();

                status.textContent = 'Gerando áudio…';
                btn.disabled = true;
                audio.src = url;
                audio.classList.remove('d-none');
                audio.play()
                    .then(function () { status.textContent = 'Tocando (' + modelo + ', ' + vel + ')'; })
                    .catch(function (e) { status.textContent = 'Falha: ' + e.message; })
                    .finally(function () { btn.disabled = false; });
            });
        })();
    </script>
{% endblock %}
